<?xml version="1.0"?>
<odoo>

        <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Estate Properties">
                <field name="name"/>
                <field name="description"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <separator/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" string="Available From"/>
                <separator/>
                <filter string="Include archived" name="archived" />
                <filter string="Postcode" name="postcode" context="{'group_by':'postcode'}" />
                <filter string="Type" name="property_type_id" context="{'group_by':'property_type_id'}" />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Available Now" name="state" domain="['|', ('state', '=', 'new'),('state', '=', 'offerReceived')]"/>
            </search>
        </field>
    </record>
        
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="property_type_id"/>
                        </group>
                        <group>
                            <field name="postcode"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                            <group>
                                <group>
                                    <field name="date_availability" string="Available From"/>
                                </group>
                                <group>
                                    <field name="state"/> 
                                </group>
                                <group>
                                    <field name="expected_price"/>
                                </group>
                                <group>
                                    <field name="selling_price"/> 
                                </group>
                                <group>
                                    <field name="bedrooms"/> 
                                </group>
                                <group>
                                    <field name="living_area" string="Living Area (sqm)"/>
                                </group>
                            </group>
                        </page>
                        <page string="Other Information">
                            <group>
                                <group>
                                    <field name="buyer_id"/>
                                </group>
                                <group>
                                    <field name="salesperson_id"/> 
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Real Estate">
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="description"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="buyer_id"/>
                <field name="salesperson_id"/>
                <field name="date_availability" string="Available From"/>
            </list>
        </field>
    </record>
    
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Property Action</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>
    
</odoo>